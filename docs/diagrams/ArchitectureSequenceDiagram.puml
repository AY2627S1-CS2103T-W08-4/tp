@startuml
!include style.puml
skinparam ArrowFontStyle plain

actor User as user USER_COLOR
participant ":UI" as ui UI_COLOR
participant ":Logic" as logic LOGIC_COLOR
participant "live:Model" as live MODEL_COLOR
participant "candidate:Model" as candidate MODEL_COLOR
participant ":Storage" as storage STORAGE_COLOR

user -> ui : "delete 1"
activate ui
ui -> logic : execute("delete 1")
activate logic
note over logic, candidate
Valid target p is resolved against the current display.
A detached candidate copies the roster and display filter.
Parsing, copying and target lookup are omitted.
end note
logic -> candidate : deletePerson(p)
activate candidate
candidate --> logic
deactivate candidate
logic -> storage : saveAddressBook(candidate.getAddressBook())
activate storage
alt save succeeds
    storage --> logic
    logic -> live : deletePerson(p)
    activate live
    live --> logic
    deactivate live
    logic --> ui : deletion result
    ui --> user : updated roster and confirmation
else IOException
    storage --> logic : throws IOException
    logic --> ui : throws CommandException
    ui --> user : save error; previous data and view retained
end
deactivate storage
deactivate logic
deactivate ui
@enduml
