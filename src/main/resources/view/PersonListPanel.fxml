<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <Label fx:id="rosterHeading" wrapText="true" style="-fx-padding: 12; -fx-text-fill: white;" />
  <ListView fx:id="personListView" VBox.vgrow="ALWAYS" />
  <ScrollPane fx:id="studentDetailsPane" fitToWidth="true" prefHeight="180" maxHeight="180"
              minHeight="80" visible="false" managed="false">
    <content>
      <Label fx:id="studentDetails" wrapText="true" style="-fx-padding: 12; -fx-text-fill: #222222;" />
    </content>
  </ScrollPane>
</VBox>
